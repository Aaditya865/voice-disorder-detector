# Python virtual environment
.venv/
venv/
env/
ENV/
*.venv

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Node / Frontend build output and dependencies
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.npm

