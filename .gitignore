*.wav
*.nsp
*.zip
*.tar
*.gz
*.mp3
*.flac
*.ogg
backend/data/

# Raw audio subdirectories in dataset (keeping metadata and README)
dataset/*/

# Environment variables, credentials, and secrets
.env
.env.*
*.pem
*.key
*.token

# Logs and runtime caches
*.log
.pytest_cache/

# OS and IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
